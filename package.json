{
  "name": "qpcr-studio",
  "version": "1.1.0",
  "description": "An offline qPCR analysis and figure studio",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build:source": "node scripts/build-source.cjs",
    "test": "playwright test",
    "test:python": ".venv\\Scripts\\python.exe -m unittest discover -s python -p test_*.py",
    "build:python": ".venv\\Scripts\\python.exe -m PyInstaller --noconfirm --onedir --name qpcr-engine --distpath python-dist/v1.1.0 --workpath python-build --specpath python-build --collect-all seaborn --hidden-import matplotlib.backends.backend_svg --hidden-import matplotlib.backends.backend_pdf --exclude-module tkinter --exclude-module IPython python/engine.py",
    "dist": "electron-builder --win portable"
  },
  "keywords": [],
  "author": "qPCR studio",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "studio.qpcr.desktop",
    "productName": "qPCR studio",
    "directories": {
      "output": "dist/v1.1.0"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "python-bridge.cjs",
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "python-dist/v1.1.0/qpcr-engine",
        "to": "qpcr-engine"
      }
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "qPCR-studio-${version}-Windows.exe"
    }
  },
  "dependencies": {
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  }
}
